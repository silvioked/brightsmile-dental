{
  "functions": {
    "public/**/*.php": {
      "runtime": "vercel-php@0.7.1",
      "includeFiles": "{config,src,views}/**"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/api/slots\\.php",
      "dest": "/public/api/slots.php"
    },
    {
      "src": "/(login|register|logout|index)\\.php",
      "dest": "/public/$1.php"
    },
    {
      "src": "/(client|receptionist|dentist|admin)/(.*)\\.php",
      "dest": "/public/$1/$2.php"
    },
    {
      "src": "/",
      "dest": "/public/login.php"
    }
  ]
}
